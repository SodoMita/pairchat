# Local development database; choose real credentials in deployment.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/app_db

# Optional strict canonical origin for API Origin checks (no trailing slash).
# APP_ORIGIN=https://chat.example.com

# Only set if a trusted ingress OVERWRITES this header with one client IP.
# Without it, anonymous admission uses a conservative shared quota.
# TRUSTED_CLIENT_IP_HEADER=x-real-ip

# Sessions are random capabilities stored as hashes in PostgreSQL.
# SESSION_SECRET and the former PID-based signing fallback are not used.
